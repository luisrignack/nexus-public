# Copia este fichero a .env antes de desplegar.
NEXUS_IMAGE=nexus-fork:3.98.1-01-local
NEXUS_HTTP_PORT=8081
NEXUS_XMS=1g
NEXUS_XMX=2g
NEXUS_CACHEBUSTER=docker-1

CLAMAV_IMAGE=clamav/clamav:1.4.7-debian
BRIDGE_IMAGE=nexus-malware-bridge:local
MALWARE_BRIDGE_PORT=8082
MALWARE_BRIDGE_URL=http://malware-bridge:8082/scan
NEXUS_MALWARE_ENABLED=true
NEXUS_MALWARE_ON_UPLOAD=true
NEXUS_MALWARE_DELETE_INFECTED=false
MAX_SCAN_BYTES=209715200

# Motor de escaneo del bridge: clamav | kaspersky-cli | kaspersky-rest
SCAN_ENGINE=clamav
# Kaspersky CLI: comando a ejecutar; {file} se sustituye por el fichero temporal
KASPERSKY_SCAN_CMD=kavscan --scan-file {file}
KASPERSKY_CMD_TIMEOUT=120
# Kaspersky REST (Security Center): URL y token (o ruta a fichero con el token)
KASPERSKY_API_URL=
KASPERSKY_TOKEN=
KASPERSKY_TOKEN_FILE=
KASPERSKY_VERIFY_TLS=true
